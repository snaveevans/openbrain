{
  "name": "@snaveevans/openbrain-cli",
  "version": "0.1.0",
  "description": "OpenBrain CLI — thin command-line client of the REST API",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "openbrain": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@snaveevans/openbrain-common": "*"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}

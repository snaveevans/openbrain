{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openbrain",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-14",
  "account_id": "361062ddedd5f7e00c273012223fbb91",
  "workers_dev": true,
  // Worker is the origin for this hostname. DNS is created on deploy.
  // tylerevans.co apex remains the Pages site.
  "routes": [{ "pattern": "openbrain.tylerevans.co", "custom_domain": true }],
  "observability": {
    "enabled": true,
  },
  // Created by scripts/ensure-cloudflare.sh (idempotent). Keep database_id
  // in sync with that script if the D1 is ever recreated.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openbrain",
      "database_id": "08681607-7750-46fd-8de9-ebac3dec3380",
      "migrations_dir": "migrations",
    },
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "openbrain-memories",
    },
  ],
  "ai": {
    "binding": "AI",
  },
  // Local only (`npm run dev` → wrangler dev -e dev). Bindings are not
  // inherited — redeclare every binding this Worker needs. Deploy without
  // --env stays on production (`openbrain-memories`). Do not
  // `wrangler deploy -e dev`.
  "env": {
    "dev": {
      // Inherited `routes` would otherwise publish this env to
      // openbrain.tylerevans.co. Keep this env undeployable as a public origin.
      "workers_dev": false,
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "openbrain",
          "database_id": "08681607-7750-46fd-8de9-ebac3dec3380",
          "migrations_dir": "migrations",
        },
      ],
      "vectorize": [
        {
          "binding": "VECTORIZE",
          "index_name": "openbrain-memories-dev",
          "remote": true,
        },
      ],
      "ai": {
        "binding": "AI",
        "remote": true,
      },
    },
  },
}

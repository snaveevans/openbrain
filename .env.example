PROJECT_ID=your-project-id
API_KEY=your-api-key

# Optional helper for scripts/delete_memory.sh
MEMORY_ID=your-memory-id

# Remote MCP settings
MCP_PUBLIC_BASE_URL=https://your-project.supabase.co/functions/v1/mcp
OAUTH_ISSUER=https://your-project.supabase.co/auth/v1

# Comma-separated allowlists for the remote MCP server
OAUTH_ALLOWED_CLIENT_IDS=
OAUTH_ALLOWED_SUBJECTS=
OAUTH_ALLOWED_EMAILS=
OAUTH_REQUIRE_AAL2=false

# Optional override for the consent/help text exposed in protected resource metadata
MCP_RESOURCE_DOCUMENTATION=
